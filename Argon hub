-- ===== Toggle Row Builder =====
local allRows = {}
local function makeToggle(parent, name, desc, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -10, 0, 52)
    row.BackgroundColor3 = THEME.card
    row.BorderSizePixel = 0
    row.LayoutOrder = order or 1
    corner(row, 8)
    row.Parent = parent

    label(row, name, UDim2.new(1, -80, 0, 18), UDim2.new(0, 12, 0, 8), THEME.text, Enum.Font.GothamMedium, 13)
    label(row, desc, UDim2.new(1, -80, 0, 16), UDim2.new(0, 12, 0, 28), THEME.subText, Enum.Font.Gotham, 10)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 40, 0, 20)
    track.Position = UDim2.new(1, -52, 0.5, -10)
    track.BackgroundColor3 = THEME.trackOff
    track.BorderSizePixel = 0
    corner(track, 10)
    track.Parent = row

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = THEME.text
    knob.BorderSizePixel = 0
    corner(knob, 10)
    knob.Parent = track

    local state = false
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row

    btn.MouseButton1Click:Connect(function()
        state = not state
        TS:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = state and THEME.trackOn or THEME.trackOff}):Play()
        TS:Create(knob, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}):Play()
        notify((state and "ON: " or "OFF: ") .. name, state and Color3.fromRGB(76, 175, 80) or THEME.accent)
    end)

    table.insert(allRows, {row = row, name = name:lower()})
    return row
end

local function sectionHeader(parent, text, order)
    local h = label(parent, text, UDim2.new(1, -10, 0, 24), UDim2.new(0, 2, 0, 0), THEME.subText, Enum.Font.GothamBold, 12)
    h.LayoutOrder = order or 1
    return h
end

-- ===== Tab System =====
local tabs = {}
local currentTab = nil
local function makeTab(name, page)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 30)
    b.BackgroundColor3 = THEME.sidebar
    b.Text = "  " .. name
    b.TextColor3 = THEME.subText
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 12
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    corner(b, 6)
    b.Parent = tabHolder
    table.insert(tabs, {btn = b, page = page, name = name})
    b.MouseButton1Click:Connect(function()
        for _, t in ipairs(tabs) do
            t.btn.BackgroundColor3 = THEME.sidebar
            t.btn.TextColor3 = THEME.subText
            t.page.Visible = false
        end
        b.BackgroundColor3 = THEME.card
        b.TextColor3 = THEME.text
        page.Visible = true
        currentTab = page
    end)
    return b
end

