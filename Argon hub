-- ===== Helpers =====
local function corner(inst, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = inst
    return c
end

local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(60, 60, 60)
    s.Thickness = thickness or 1
    s.Transparency = 0.5
    s.Parent = inst
    return s
end

local function label(parent, text, size, pos, color, font, size2)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or THEME.text
    l.Font = font or Enum.Font.Gotham
    l.TextSize = size2 or 13
    l.Size = size
    l.Position = pos
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent
    return l
end

local function notify(msg, color)
    local n = Instance.new("Frame")
    n.Size = UDim2.new(0, 240, 0, 40)
    n.Position = UDim2.new(0.5, -120, 0, 20)
    n.BackgroundColor3 = THEME.card
    n.BorderSizePixel = 0
    corner(n, 8)
    stroke(n, color or THEME.accent, 1.5)
    local t = label(n, msg, UDim2.new(1, -16, 1, 0), UDim2.new(0, 8, 0, 0), THEME.text, Enum.Font.GothamMedium, 12)
    n.Parent = gui
    TS:Create(n, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -120, 0, 60)}):Play()
    task.delay(3, function()
        TS:Create(n, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -120, 0, 10), BackgroundTransparency = 1}):Play()
        TS:Create(t, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        task.delay(0.5, function() n:Destroy() end)
    end)
end

