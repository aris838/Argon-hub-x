    task.delay(0.35, function()
        keyScreen.Visible = false
        sidebar.Visible = true
        content.Visible = true
        tabs[1].btn.MouseButton1Click:Fire()
    end)
    notify("Key valid — hub terbuka.", Color3.fromRGB(76, 175, 80))
end

enterBtn.MouseButton1Click:Connect(function()
    local entered = keyInput.Text:gsub("%s", "")
    if entered == VALID_KEY then
        unlockHub()
    else
        stroke(keyInput, THEME.accent, 1.5)
        notify("Key salah. Coba lagi.", THEME.accent)
        task.delay(0.8, function()
            if keyInput and keyInput.Parent then stroke(keyInput, Color3.fromRGB(60, 60, 60), 1) end
        end)
    end
end)

